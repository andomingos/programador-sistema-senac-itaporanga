@model List<SistemaControleMateriaisWeb.Models.Usuario>

@{
    ViewData["Title"] = "Usuários";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">Usuários</h1>

    <a asp-action="Create"
       class="btn btn-primary">
        Novo usuário
    </a>
</div>

@if (TempData["Mensagem"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensagem"]
    </div>
}

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Status</th>
            <th>Criado em</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.Nome</td>
                <td>@usuario.Email</td>

                <td>
                    @if (usuario.Ativo)
                    {
                        <span class="badge bg-success">
                            Ativo
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Inativo
                        </span>
                    }
                </td>

                <td>
                    @usuario.CriadoEm.ToString("dd/MM/yyyy HH:mm")
                </td>
            </tr>
        }
    </tbody>
</table>